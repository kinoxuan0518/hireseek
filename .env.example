# ── HireSeek 配置示例（复制为 .env 并填写）──────────────────────────

# ── LLM Provider ──────────────────────────────────────────
# 可选: deepseek（默认）| glm | kimi | claude | openai | minimax | custom
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-v4-flash
#
# 寻源开车可以换一个脑（不填则跟 LLM_PROVIDER）：
# DRIVER_PROVIDER=glm
# DRIVER_MODEL=glm-5.3-flash
# 读图专用（不填：开车模型能看就用它；DeepSeek 则升到 vision-exp）：
# VISION_PROVIDER=kimi
# VISION_MODEL=kimi-k3
# 浏览器手：auto（默认，Kimi/GLM 走 DOM）| dom | vision
# HIRESEEK_BROWSER_MODE=auto
# 思考强度：low / high / max（Kimi/GLM 寻源默认 low）
# HIRESEEK_REASONING_EFFORT=low

# DeepSeek（默认便宜文本脑）
DEEPSEEK_API_KEY=sk-your-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_REASONER_MODEL=deepseek-v4-pro

# 智谱 GLM-5.3-Flash（原生视觉，推荐 CN 寻源）
# ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Kimi K3（原生视觉）
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ── 其他 provider（只填你用的）──────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.chat/v1

# 其他 OpenAI 兼容 provider
# LLM_PROVIDER=custom
# CUSTOM_API_KEY=your_key
# CUSTOM_BASE_URL=https://your-provider/v1
# LLM_MODEL=your-model-name

# ── 数据库 ─────────────────────────────────────────────────
# 默认 ~/.hireseek/hireseek.db（自动兼容旧 ~/.hireclaw/hireclaw.db）
# HIRESEEK_DB_PATH=

# ── Canonical 知识/契约层（可选）─────────────────────────────
# 不填则使用 HireSeek 内置兜底契约；填写后优先读取独立 sandbox/repo 中的契约。
# AGENT_KNOWLEDGE_HOME=$HOME/agent-knowledge-lab

# ── Runtime 技能目录（可选）──────────────────────────────────
# 默认读取本机 Codex/Claude 技能库；仓库内 workspace/skills 只作为兜底。
# 多个目录用系统路径分隔符连接；macOS/Linux 用冒号。
# HIRESEEK_SKILL_HOME=~/.codex/skills:~/.claude/skills
# HIRESEEK_EXTERNAL_SKILLS=true
# HIRESEEK_PRELOAD_LEGACY_SKILLS=false

# ── 飞书：执行报告推送（可选）──────────────────────────────
# 飞书群自定义机器人 Webhook，不填则结果只打印到终端
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# ── 飞书：多维表格读取（进化闭环，可选）────────────────────
# 自建应用需开通 bitable:app:readonly 权限
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_BITABLE_APP_TOKEN=
# FEISHU_BITABLE_TABLE_ID=

# ── 浏览器 ─────────────────────────────────────────────────
# 默认接管你已打开的真实 Chrome；如必须使用 HireSeek 自有浏览器，可改为 hireseek
# HIRESEEK_BROWSER_CONTROL=chrome
# 招聘平台有反爬，默认不用 headless 模式
BROWSER_HEADLESS=false
# HireSeek 自有浏览器的持久资料夹；登录一次后 Cookie/LocalStorage 会保留
# HIRESEEK_BROWSER_PROFILE_DIR=~/.hireseek/browser-profile

# ── 定时任务（Cron，工作日自动触发）──────────────────────
SCHEDULE_BOSS=0 9 * * 1-5
SCHEDULE_MAIMAI=0 10 * * 1-5
SCHEDULE_FOLLOWUP=0 14 * * 1-5
